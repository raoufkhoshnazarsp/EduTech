# این فایل را به .env کپی کنید و مقادیر را عوض کنید.
# هیچ‌کدام از این مقادیر را در گیت ذخیره نکنید.
# مقادیر دارای فاصله را داخل "..." بگذارید.

# آدرس نهایی سایت، با https و بدون اسلش آخر.
# اگر دامنه ندارید این را خالی بگذارید؛ اسکریپت نصب خودش
# یک زیردامنه رایگان DuckDNS می‌سازد و SSL می‌گیرد.
SITE_URL=""

# اگر زیردامنه DuckDNS دارید، نامش را اینجا بگذارید (بدون .duckdns.org)
# و توکن حساب DuckDNS را برای به‌روزرسانی خودکار IP
DUCKDNS_SUBDOMAIN=""
DUCKDNS_TOKEN=""

# نام سایت که به دانش‌آموزان نشان داده می‌شود
MOODLE_SITENAME="آموزشگاه من"

# حساب مدیر اصلی (اولین ورود)
MOODLE_USERNAME="admin"
MOODLE_PASSWORD="یک-رمز-قوی-بگذارید"
MOODLE_EMAIL="admin@example.com"

# دیتابیس (رمز را عوض کنید؛ فقط حروف و رقم بگذارید)
DB_NAME="moodle"
DB_USER="moodle"
DB_PASS="یک-رمز-دیگر-بگذارید"

# ایمیل خروجی (برای بازیابی رمز و اطلاع‌رسانی)
# اگر Gmail دارید: smtp.gmail.com / 587 / tls و App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="app-password"
SMTP_PROTOCOL="tls"
MOODLE_MAIL_NOREPLY_ADDRESS="noreply@example.com"
